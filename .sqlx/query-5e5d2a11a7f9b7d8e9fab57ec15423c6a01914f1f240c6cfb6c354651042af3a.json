  "query": "\n        SELECT u.balance_micro,\n               COALESCE((SELECT SUM(delta_micro) FROM billing_events e WHERE e.user_id = u.id), 0)::bigint\n                   AS \"events_sum!\"\n        FROM users u WHERE u.id = $1 AND u.deleted_at IS NULL\n        ",
