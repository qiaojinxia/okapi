{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT id, username, email, role, status, balance_micro, admin_role_id,\n               price_multiplier::text AS \"multiplier!\", created_at\n        FROM users\n        WHERE deleted_at IS NULL\n          AND ($1::text IS NULL OR username ILIKE $1 OR email ILIKE $1)\n        ORDER BY id DESC\n        LIMIT $2 OFFSET $3\n        ",
