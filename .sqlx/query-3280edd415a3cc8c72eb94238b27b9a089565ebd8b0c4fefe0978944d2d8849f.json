  "query": "\n        SELECT id, created_at, payload\n        FROM billing_outbox\n        WHERE status = 0 AND (next_retry_at IS NULL OR next_retry_at <= now())\n        ORDER BY id\n        LIMIT $1\n        FOR UPDATE SKIP LOCKED\n        ",
