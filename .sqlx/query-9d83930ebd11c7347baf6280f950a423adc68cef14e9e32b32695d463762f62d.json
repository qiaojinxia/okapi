{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT c.id AS channel_id, c.api_base, ck.credential_ciphertext\n        FROM channel_keys ck\n        JOIN channels c ON c.id = ck.channel_id\n        WHERE ck.id = $1 AND ck.status = 1 AND c.status = 1 AND c.deleted_at IS NULL\n        ",
