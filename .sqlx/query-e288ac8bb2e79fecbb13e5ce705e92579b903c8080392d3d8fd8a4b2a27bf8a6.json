{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT c.provider, c.api_base, c.settings, ck.id AS channel_key_id,\n               ck.credential_ciphertext\n        FROM channels c\n        JOIN channel_keys ck ON ck.channel_id = c.id\n        WHERE c.id = $1 AND c.deleted_at IS NULL\n        ORDER BY (ck.status = 1) DESC, ck.id\n        LIMIT 1\n        ",
