  "query": "\n        SELECT rule_code, rule_type, scope, params, priority, enabled, valid_from, valid_to\n        FROM pricing_rules\n        ORDER BY\n            CASE rule_type\n                WHEN 'volume' THEN 0\n                WHEN 'time_based' THEN 1\n                WHEN 'discount' THEN 2\n                ELSE 3\n            END,\n            priority,\n            rule_code\n        ",
