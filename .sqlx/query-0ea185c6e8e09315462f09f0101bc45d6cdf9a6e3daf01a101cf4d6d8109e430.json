  "query": "\n        SELECT p.id, p.plan_code, p.display_name, p.grant_micro, p.group_code,\n               p.balance_valid_days, p.status, p.created_at,\n               (SELECT COUNT(*) FROM redemption_codes r WHERE r.plan_id = p.id)\n                   AS \"code_count!\"\n        FROM plans p ORDER BY p.id DESC\n        ",
