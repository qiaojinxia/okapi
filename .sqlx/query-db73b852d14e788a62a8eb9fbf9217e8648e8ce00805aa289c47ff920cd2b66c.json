  "query": "SELECT event_id, event_type, delta_micro, balance_after_micro, payload, actor, created_at\n           FROM billing_events\n           WHERE user_id = $1\n             AND event_type IN ('recharge', 'adjust', 'refund', 'expire')\n             AND delta_micro <> 0\n           ORDER BY event_id DESC LIMIT 10",
