  "query": "\n        SELECT id, name, provider, api_base, status, priority, models, trust_upstream_usage, owner_id\n        FROM channels\n        WHERE deleted_at IS NULL AND ($1::bigint IS NULL OR owner_id = $1)\n        ORDER BY priority DESC, id\n        ",
