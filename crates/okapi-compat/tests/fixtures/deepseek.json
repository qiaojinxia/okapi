[
  {
    "name": "developer messages become system on the OpenAI chat dialect",
    "vendor": "deepseek",
    "rule": "strict-role.developer-to-system",
    "context": { "vendor": "builtin:deepseek", "host": "api.deepseek.com", "model": "deepseek-chat", "dialect": "openai.chat" },
    "input": {
      "model": "deepseek-chat",
      "messages": [
        { "role": "developer", "content": "be brief" },
        { "role": "user", "content": "hi" },
        { "role": "developer", "content": "again" }
      ]
    },
    "expect": {
      "model": "deepseek-chat",
      "messages": [
        { "role": "system", "content": "be brief" },
        { "role": "user", "content": "hi" },
        { "role": "system", "content": "again" }
      ]
    },
    "fires": true
  },
  {
    "name": "nothing to do when no message uses the developer role",
    "vendor": "deepseek",
    "rule": "strict-role.developer-to-system",
    "context": { "vendor": "builtin:deepseek", "host": "api.deepseek.com", "model": "deepseek-chat", "dialect": "openai.chat" },
    "input": { "model": "deepseek-chat", "messages": [{ "role": "system", "content": "s" }, { "role": "user", "content": "u" }] },
    "expect": { "model": "deepseek-chat", "messages": [{ "role": "system", "content": "s" }, { "role": "user", "content": "u" }] },
    "fires": false
  },
  {
    "name": "other upstream dialects are left alone",
    "vendor": "deepseek",
    "rule": "strict-role.developer-to-system",
    "context": { "vendor": "builtin:deepseek", "host": "api.deepseek.com", "model": "deepseek-chat", "dialect": "anthropic.messages" },
    "input": { "model": "deepseek-chat", "messages": [{ "role": "developer", "content": "x" }] },
    "expect": { "model": "deepseek-chat", "messages": [{ "role": "developer", "content": "x" }] },
    "fires": false
  }
]
