    "rules": [
      {
        "id": "strict-role.developer-to-system",
        "select": { "dialect": ["openai.chat"] },
        "do": [{ "op": "role_map", "from": "developer", "to": "system" }],
        "doc": {
          "why": "智谱 / Z.ai 拒收 developer 角色。来源：sub2api backend/internal/service/openai_chat_roles.go requiresSystemChatRole。",
