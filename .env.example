# 复制为 .env（本地开发；.env 已 gitignore）
# sqlx 编译期校验与运行时共用
DATABASE_URL=postgres://okapi:okapi_dev@localhost:54329/okapi
OKAPI_REDIS_URL=redis://localhost:63790
# M2 chsink/outbox relay（可选：缺省关闭，统计接口 fail-closed）
OKAPI_NATS_URL=nats://localhost:14222
OKAPI_CLICKHOUSE_URL=http://okapi:okapi_dev@localhost:18123
OKAPI_BIND=127.0.0.1:8080
# 进程时区：时段折扣与统计页"今天 / 本月"按它算；多副本必须一致（限额与渠道计数器固定按 UTC 重置）。
# TZ=Asia/Shanghai
# 控制台监听地址（缺省 127.0.0.1:8081；容器里要对外暴露时设 0.0.0.0:8081）
# OKAPI_CONSOLE_BIND=127.0.0.1:8081
# 实例名：记账的 node 列与集群在途量表按它区分实例。缺省取 HOSTNAME（Docker/K8s 每个容器唯一），
# 再退到 okapi-1；裸机多实例必须各设一个不同值，否则在途量互相覆盖、集群在途数算少。
# OKAPI_NODE=okapi-1
# HTTPS 部署保留 true；纯 HTTP 内网部署可显式设 false（会话与 OAuth state 同时生效）。
OKAPI_COOKIE_SECURE=true
# Redis 结算重试日志容量与恢复批次；满时拒绝继续新增日志，不淘汰旧账。
OKAPI_SETTLEMENT_JOURNAL_MAX=100000
OKAPI_SETTLEMENT_RECOVERY_BATCH=500
# 网关结算积压上界（缺省 20000 ≈ PG 记账速率 × 下线窗口）：在途未落账的结算超过它时新请求回 503，
# 防止过载把内存和下线时长一起拖垮。0 = 不设限（只用于压测网关自身开销，见 docs/perf-report.md）。
# OKAPI_SETTLE_BACKLOG_MAX=20000
# PG 连接池上限（缺省 16）。本地跑 cargo test 建议设小：测试并行时每个二进制各建
# 连接池，池过大会连接耗尽导致随机失败（dev-deps.sh 已把 PG max_connections 提到 300）。
# 多副本部署：每个 pod 各开一套池，总连接 = Σ(副本数 × 本值)，必须 ≤ PG max_connections
# 并留出运维余量——扩容时这是第一个撞墙的地方，且现象是 acquire 超时而非"连不上"。
OKAPI_PG_POOL=6
# 单用户模式：跳过注册体系，启动时自动生成 root key 打印到日志
OKAPI_SINGLE_USER_MODE=false
# release 构建开单用户模式还须二次确认（root key 会进 stdout 日志，误开公网代价高）
# OKAPI_SINGLE_USER_CONFIRM=true
# 信封加密主密钥（32 字节 hex；TOTP 等敏感字段。生成：openssl rand -hex 32）
# 留空表示未配置：开发环境可使用历史明文凭证，TOTP 注册不可用；生产环境应配置密钥。
# 新建用户 API Key 仅在配置后保存加密副本供账号会话再次复制；留空只存哈希、无法再次复制。
OKAPI_MASTER_KEY=
# 信任反代 / CDN 回源段（地址或 CIDR，逗号分隔）。**未设置**= 仅信任环回（同机 nginx
# 开箱可用）；显式设空串 = 谁都不信（网关直连公网时的正确配置）。
# 只有来自信任来源的 X-Forwarded-For / CDN 头才作数——否则 key 级 IP 白名单、登录与
# 兑换的每 IP 限流、日志 client_ip 列都能被调用方一个请求头改写（§14.2）。
# 容器 / K8s 里反代与网关不同 IP，务必按实际网段配置，例如：
# OKAPI_TRUSTED_PROXIES=127.0.0.1/32,::1/128,172.16.0.0/12
OKAPI_TRUSTED_PROXIES=127.0.0.1/32,::1/128
# 边缘凭证（§14.2 模式二）：CDN 在回源时注入 X-Okapi-Edge-Key，验证通过即信任转发头，
# 免维护回源 IP 段。留空 = 不启用。生成：openssl rand -hex 32
OKAPI_EDGE_KEY=
# 异步图片结果存储（gateway 与 worker 使用同一配置；JSON，重启生效）。
# 空值：base64 保存 PG，外部 URL 保持原样。仅转存 URL 到 PG 可设 {"copy_urls":true}。
# 私有 S3 配置/旧存储保留/清理策略见 docs/images-contract.md；凭证仅由部署环境注入。
OKAPI_IMAGE_STORAGE=

# Remote/proxied first initialization requires this secret; direct loopback without forwarding headers does not.
# Generate a unique value before exposing a new deployment.
OKAPI_SETUP_TOKEN=

# 仅 `okapi migrate --from okapi-old`：旧库 API key 的加密口令（等价 --enc-passphrase，用环境变量
# 免得口令进 shell history / 进程列表）。不给则旧 key 全部跳过。
# OKAPI_OLD_ENC_PASSPHRASE=
# 仅非 embed-web 构建（开发形态）：前端静态目录，缺省 frontend/dist
# OKAPI_WEB_DIR=frontend/dist
